{
  "name": "astro-uhr-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:vitest": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:bdd": "bddgen && playwright test --project=bdd --workers=1",
    "test:bdd:update": "bddgen && playwright test --project=bdd --workers=1 --update-snapshots",
    "test:bdd:steps": "bddgen export",
    "test:bdd:coverage": "bddgen && node features/support/mit-abdeckung.mjs --workers=1"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@vercel/analytics": "^2.0.1",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.3",
    "@types/three": "0.186.0",
    "jsdom": "^28.0.0",
    "monocart-coverage-reports": "2.13.2",
    "playwright-bdd": "9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
